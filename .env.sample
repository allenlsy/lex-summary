# SSSF environment. Copy to .env only when using API-key authentication.
#
# WHICH KEYS YOU NEED DEPENDS ON YOUR ROSTER.
# Every `model:` in adws/adw_sssf_config/sssf.config.yaml is written as
# provider/model-id. The provider half decides which key must be set, and which
# key Pi reads depends on that provider.
#
# This roster uses openai-codex models authenticated through Pi's ChatGPT
# OAuth login. Pi stores and refreshes that credential in ~/.pi/agent/auth.json,
# so no .env file or API key is required for the current configuration.
#
# If you later switch to direct OpenAI API billing, change each model provider
# from `openai-codex` to `openai` and uncomment this variable:
# OPENAI_API_KEY=

# Other optional provider keys, needed only when named by the roster:
# OPENROUTER_API_KEY=
# FIREWORKS_API_KEY=
# GEMINI_API_KEY=

# Optional overrides
# PI_PATH=pi                       # pi binary if not on PATH
# PI_MODELS_PATH=~/.pi/agent/models.json
# ENGINEER_NAME=                   # engineer lane label, defaults to git user.name
